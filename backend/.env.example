# AfyaLink backend configuration.
# Copy to .env for local development:  cp .env.example .env
#
# Every value below is validated at startup — the process refuses to boot on a
# missing or malformed secret rather than falling back to a weak default.

APP_ENV=development
PORT=8080

# Dev Postgres from docker-compose.yml (host port 5433 avoids clashing with a
# system Postgres already on 5432).
DATABASE_URL=postgres://afyalink:devpassword@127.0.0.1:5433/afyalink?sslmode=disable

# HMAC signing key for JWT access tokens. Must be >= 32 bytes decoded.
#   openssl rand -base64 32
JWT_SECRET=REPLACE_ME_WITH_openssl_rand_base64_32

# AES-256-GCM key for PHI field encryption (diagnosis, allergies, discharge
# summary, clinical notes). Must decode to EXACTLY 32 bytes.
#   openssl rand -base64 32
#
# Rotating this key without re-encrypting existing rows makes every stored PHI
# field permanently unreadable. There is no key-version column in this MVP;
# see README "Production secrets" before rotating.
PHI_ENCRYPTION_KEY=REPLACE_ME_WITH_openssl_rand_base64_32

# Exact frontend origin(s), comma-separated. A wildcard is rejected at startup.
CORS_ORIGINS=http://localhost:5173

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Per-IP sustained rate and burst for /api/auth/login and /api/auth/refresh.
LOGIN_RATE_LIMIT_PER_MIN=10
LOGIN_RATE_BURST=5

# How often the scheduler generates check-ins / medication doses and sweeps for
# overdue rows.
SCHEDULER_PERIOD=1m
